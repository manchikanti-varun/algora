{
  "name": "algora-backend",
  "version": "0.1.0",
  "private": true,
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "start:worker": "node dist/worker.js",
    "test:browser": "node tests/browser/run.mjs && node tests/browser/sync.mjs",
    "test:load": "node tests/load/run.mjs",
    "backup": "bash scripts/ops/backup.sh",
    "migrate:problem-catalog": "tsx scripts/migrations/migrate-problem-catalog.ts",
    "migrate:leetcode-links": "tsx scripts/migrations/migrate-leetcode-links.ts",
    "start:prod-local": "node --env-file=.env.production dist/server.js"
  },
  "engines": {
    "node": ">=20.11 <27"
  },
  "dependencies": {
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.5",
    "google-auth-library": "^11.3.4",
    "helmet": "^8.3.0",
    "leetcode-query": "^2.0.1",
    "mongoose": "^9.13.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@types/supertest": "^7.2.1",
    "mongodb-memory-server": "^11.4.0",
    "playwright": "^1.65.1",
    "supertest": "^7.3.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1"
  },
  "config": {
    "mongodbMemoryServer": {
      "disablePostinstall": "1"
    }
  }
}
