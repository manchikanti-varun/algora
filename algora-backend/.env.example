NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/algora
CORS_ORIGINS=http://localhost:3000
TRUST_PROXY_HOPS=0
LOG_LEVEL=info
FRONTEND_URL=http://localhost:3000
SESSION_TTL=604800
# Set all three Google variables together; leave unset until credentials exist.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=http://localhost:3000/backend/auth/google/callback
# CLI only: set the existing verified Google subject before interactive provisioning.
# PROVISION_SUPER_ADMIN_SUBJECT=
# Optional QR vault: backend-only JSON object of key IDs to base64-encoded 32-byte keys.
# QR_ENCRYPTION_KEYS=
# QR_ACTIVE_KEY_ID=
# Retain previous keys until all associated credentials have been safely re-encrypted.
