# Core application. Railway supplies PORT.
NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/algora?replicaSet=rs0
GOOGLE_CLIENT_ID=
SUPER_ADMIN_EMAIL=yourname@gmail.com
# Generate a distinct random secret of at least 32 characters.
SESSION_SECRET=
FRONTEND_URL=http://localhost:3000
TRUST_PROXY_HOPS=1

# Optional LeetCode integration. Core routes remain available while sync is off.
LEETCODE_SYNC_ENABLED=false
# The single production activation safeguard. Not a LeetCode credential (the GraphQL endpoint needs none).
# NONE keeps real providers inactive. Set one of TERMS, WRITTEN_PERMISSION, LICENSED_THIRD_PARTY, INSTITUTIONAL or
# COMMERCIAL only when that upstream authorization actually covers Algora's automated access. Internal risk acceptance
# (OWN_RISK) is not upstream authorization and is rejected.
LEETCODE_ACCESS_BASIS=NONE
# Comma-separated, preferred first. Allowed: direct, leetcode-query, alfa, mock. Alfa and mock stay off unless enabled below.
LEETCODE_PROVIDER_PRIORITY=direct,leetcode-query
LEETCODE_DIRECT_ENABLED=false
LEETCODE_QUERY_ENABLED=false
LEETCODE_ALFA_ENABLED=false
LEETCODE_MOCK_ENABLED=false

# Alfa (community relay) stays off. Only if you ever enable it: LEETCODE_ALFA_BASE_URL=https://..., LEETCODE_ALFA_CACHE_SEC, LEETCODE_ALFA_RATE_PER_MIN.
LEETCODE_QUERY_MODE=accepted

# Request budgets. GLOBAL is the ONE budget shared by every provider and backend instance (direct, leetcode-query, health checks,
# probes, retries, reconciliation). Per-provider values count inside it, not on top of it. These are engineering limits for
# testing, not limits LeetCode has approved. Burst is a fifth of a minute's budget (min 2), so requests are paced.
LEETCODE_GLOBAL_RATE_PER_MIN=10
# LEETCODE_DIRECT_RATE_PER_MIN=10
# LEETCODE_QUERY_RATE_PER_MIN=10
# Manual update cooldown per student, in seconds, counted from the student's last manual request (600 = 10 minutes).
LEETCODE_STUDENT_COOLDOWN_SEC=600
# Maximum simultaneous synchronizations across all instances. Admins can only lower it at runtime.
LEETCODE_CONCURRENCY=2
# Automatic interval in minutes after each student's last SUCCESSFUL synchronization (manual successes reset it too).
LEETCODE_SYNC_INTERVAL_MINUTES=30
LEETCODE_PROVIDER_TIMEOUT_MS=10000
LEETCODE_PROVIDER_FAILURE_THRESHOLD=5
LEETCODE_PROVIDER_RECOVERY_INTERVAL_SEC=120
LEETCODE_MAX_FAILOVER=1
# LEETCODE_HEALTHCHECK_USERNAME=
# LEETCODE_CONTACT=
LEETCODE_SCHEDULER_ENABLED=true
LEETCODE_BOOTCAMP_HOURS=09:30-16:30
LEETCODE_BOOTCAMP_DAYS=1,2,3,4,5
LEETCODE_TZ_OFFSET_MIN=330
# Optional term dates (YYYY-MM-DD, whole days in the bootcamp timezone, end inclusive). Outside the term only the final
# reconciliation runs. Example for the December 2026 bootcamp: LEETCODE_BOOTCAMP_START=2026-12-07, LEETCODE_BOOTCAMP_END=2026-12-11
# A batch can override hours, days, timezone and term dates in its own settings.
# LEETCODE_BOOTCAMP_START=
# LEETCODE_BOOTCAMP_END=
