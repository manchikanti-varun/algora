# ---------- Required ----------
NODE_ENV=development
PORT=5000                     # Railway sets PORT itself. Locally, macOS AirPlay uses 5000: pick 5100 or turn AirPlay Receiver off.
MONGODB_URI=mongodb://127.0.0.1:27017/algora?replicaSet=rs0   # Atlas in staging/production. Must be a replica set if sync is enabled.
GOOGLE_CLIENT_ID=             # Web OAuth client id from Google Cloud Console. Same value as the frontend's NEXT_PUBLIC_GOOGLE_CLIENT_ID.
SUPER_ADMIN_EMAIL=yourname@gmail.com   # Exactly one. Changing it revokes the previous Super Admin.
SESSION_SECRET=               # >= 32 chars. Generate: openssl rand -base64 48
FRONTEND_URL=http://localhost:3000     # Exact origin of the frontend (Vercel URL in production). Used for CORS and CSRF origin checks.

# ---------- Optional ----------
BACKEND_URL=http://localhost:5000
GOOGLE_CLIENT_SECRET=         # Not used (ID-token flow). Leave empty.
TRUST_PROXY_HOPS=1            # Reverse proxies in front of Express (Railway edge = 1).

# ---------- LeetCode verification (keep OFF until authorised and the live PoC passes) ----------
# These are defaults and CEILINGS, not verified production limits. Admins can only lower limits / disable providers at runtime.
LEETCODE_SYNC_ENABLED=false
# LEETCODE_PERMISSION_REF=          # LeetCode's written permission reference. Without it NO provider that reaches LeetCode is authorised.
LEETCODE_PROVIDER_PRIORITY=direct,leetcode-query,alfa

LEETCODE_DIRECT_ENABLED=false       # Provider 1: thin GraphQL client (accepted-only list), from this server
LEETCODE_ALFA_ENABLED=false         # Provider 2: Alfa LeetCode API (relay)
LEETCODE_QUERY_ENABLED=false        # Provider 3: leetcode-query npm package, from this server
LEETCODE_MOCK_ENABLED=false         # development/test only; refused in production

LEETCODE_ALFA_BASE_URL=             # your authorised (preferably self-hosted) Alfa deployment
# LEETCODE_ALFA_PERMISSION_REF=     # terms/permission for that deployment, or "self-hosted"
LEETCODE_ALFA_CACHE_SEC=300         # Alfa caches responses (apicache, 5 min by default)
LEETCODE_ALFA_RATE_PER_MIN=2        # Alfa's own default limiter is 120/hour per IP
LEETCODE_QUERY_MODE=accepted        # accepted | all-status (all-status = reduced coverage, reported to students)
# LEETCODE_DIRECT_RATE_PER_MIN=     # defaults to the global ceiling
# LEETCODE_QUERY_RATE_PER_MIN=

LEETCODE_GLOBAL_RATE_PER_MIN=20     # shared LeetCode budget for ALL providers and instances (MongoDB bucket)
LEETCODE_STUDENT_COOLDOWN_SEC=300
LEETCODE_CONCURRENCY=3
LEETCODE_SYNC_INTERVAL_MINUTES=60   # idle students during bootcamp hours (active students: 15 min, admin-adjustable)

LEETCODE_PROVIDER_TIMEOUT_MS=10000
LEETCODE_PROVIDER_FAILURE_THRESHOLD=5
LEETCODE_PROVIDER_RECOVERY_INTERVAL_SEC=120   # first circuit pause; doubles per failed probe up to 15 min
LEETCODE_MAX_FAILOVER=2                       # extra providers tried per request after a provider-specific failure
# LEETCODE_HEALTHCHECK_USERNAME=              # a CONSENTING account for admin-triggered health checks
# LEETCODE_CONTACT=ops@yourorg.com            # included in the User-Agent so LeetCode can reach you

LEETCODE_SCHEDULER_ENABLED=true     # false on API replicas when the separate worker service runs the scheduler
LEETCODE_BOOTCAMP_HOURS=09:30-16:30
LEETCODE_BOOTCAMP_DAYS=1,2,3,4,5    # 0 = Sunday
LEETCODE_TZ_OFFSET_MIN=330          # IST
